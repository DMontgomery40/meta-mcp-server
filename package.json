{
  "name": "meta-mcp-server",
  "version": "1.5.4",
  "type": "module",
  "description": "MCP server that helps Claude create other MCP servers with persistent knowledge",
  "main": "build/main.js",
  "bin": {
    "meta-mcp-server": "./build/main.js"
  },
  "private": false,
  "mcp": {
    "server": {
      "command": "node",
      "args": ["./build/main.js"]
    }
  },
  "files": [
    "build",
    "README.md",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x build/main.js && cp src/SYSTEM_PROMPT.md build/",
    "dev": "tsc --watch",
    "start": "node build/main.js",
    "publish": "npm publish --access public"},
  "repository": {
    "type": "git",
    "url": "https://github.com/DMontgomery40/meta-mcp-server.git"},
  "keywords": ["canvas", "mcp", "server", "modelcontextprotocol"],
  "author": "David Montgomery",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  }
}